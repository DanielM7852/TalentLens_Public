# Copy to .env.local and adjust for your environment.
# FastAPI backend (CORS must allow your Next.js origin, e.g. http://localhost:3000)

# Local dev:
NEXT_PUBLIC_API_URL=http://localhost:8000

# Vercel production (required — use your Railway public HTTPS URL, no trailing slash):
# NEXT_PUBLIC_API_URL=https://your-service.up.railway.app
