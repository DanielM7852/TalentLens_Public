# xAI API key for Grok (skill extraction + match explanations in Streamlit)
# Get one at https://console.x.ai/
# Copy this file to .env and fill in your key.
XAI_API_KEY=your-xai-api-key-here

# Optional — use on Railway / other 1GB hosts to avoid OOM "Killed" (skips cross-encoder)
# TALENTLENS_DISABLE_RERANKER=1
# TALENTLENS_GROK_MAX_WORKERS=2
